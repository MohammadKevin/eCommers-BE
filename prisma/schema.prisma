// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

enum GlobalRole {
  SUPER_ADMIN
  OPERATIONS_CS
  FINANCE_ADMIN
  MARKETING_ADMIN
  USER
}

enum StoreRole {
  OWNER
  ADMIN
  CS
  MARKETING
}

enum UserTier {
  SILVER
  GOLD
  PLATINUM
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  fullName     String
  avatarUrl    String?
  globalRole   GlobalRole @default(USER)
  tier         UserTier   @default(SILVER)
  isAffiliate  Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  addresses      Address[]
  stores         StoreMember[]
  orders         Order[]            @relation("BuyerOrders")
  reviews        Review[]
  cart           Cart?
  wishlists      Wishlist[]
  affiliateData  AffiliateProfile?
  driverProfile  DriverProfile?
  warehouseStaff WarehouseStaff?
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String
  recipient   String
  phone       String
  fullAddress String   @db.Text
  city        String
  province    String
  postalCode  String
  isPrimary   Boolean  @default(false)

  @@index([userId])
}

model Store {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  logoUrl     String?
  description String?  @db.Text
  city        String?  // Untuk asal perhitungan ongkir
  province    String?
  postalCode  String?
  isOfficial  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     StoreMember[]
  products    Product[]
  orders      Order[]
  vouchers    Voucher[]
}

model StoreMember {
  id      String    @id @default(uuid())
  storeId String
  userId  String
  role    StoreRole @default(ADMIN)

  store   Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([storeId])
  @@index([userId])
}

model Category {
  id       String     @id @default(uuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")
  products Product[]

  @@index([parentId])
}

model Product {
  id          String   @id @default(uuid())
  storeId     String
  categoryId  String
  name        String
  slug        String   @unique
  description String   @db.Text
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store     Store            @relation(fields: [storeId], references: [id])
  category  Category         @relation(fields: [categoryId], references: [id])
  images    ProductImage[]
  variants  ProductVariant[]
  reviews   Review[]
  wishlists Wishlist[]

  @@index([storeId])
  @@index([categoryId])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  imageUrl  String
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id             String   @id @default(uuid())
  productId      String
  sku            String   @unique
  name           String   // Misal: "Merah - XL"
  price          Decimal  @db.Decimal(12, 2)
  wholesalePrice Decimal? @db.Decimal(12, 2)
  stock          Int      @default(0)
  weight         Int      @default(500) // Berat dalam gram
  imageUrl       String?

  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  cartItems      CartItem[]

  @@index([productId])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String
  variantId String
  quantity  Int            @default(1)

  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  REFUNDED
}

model Order {
  id             String      @id @default(uuid())
  orderNumber    String      @unique
  buyerId        String
  storeId        String
  voucherId      String?
  status         OrderStatus @default(PENDING_PAYMENT)
  
  // Amounts
  subtotalAmount Decimal     @db.Decimal(12, 2)
  discountAmount Decimal     @default(0.00) @db.Decimal(12, 2)
  shippingCost   Decimal     @db.Decimal(10, 2)
  totalAmount    Decimal     @db.Decimal(12, 2)

  // Snapshot Alamat Pengiriman
  shippingRecipient  String
  shippingPhone      String
  shippingAddress    String   @db.Text
  shippingCity       String
  shippingProvince   String
  shippingPostalCode String

  isB2BOrder   Boolean   @default(false)
  paymentTerms String?   // Misal: "NET 30"

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  buyer        User                 @relation("BuyerOrders", fields: [buyerId], references: [id])
  store        Store                @relation(fields: [storeId], references: [id])
  voucher      Voucher?             @relation(fields: [voucherId], references: [id])
  items        OrderItem[]
  shipment     Shipment?
  payment      PaymentTransaction?

  @@index([buyerId])
  @@index([storeId])
  @@index([voucherId])
}

model OrderItem {
  id          String         @id @default(uuid())
  orderId     String
  variantId   String
  
  // Snapshot Data Produk saat Checkout
  productName String
  variantName String
  sku         String
  imageUrl    String?
  price       Decimal        @db.Decimal(12, 2)
  quantity    Int

  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
}

model PaymentTransaction {
  id            String        @id @default(uuid())
  orderId       String        @unique
  paymentMethod String        // e.g. "BCA_VA", "QRIS", "GOPAY", "CREDIT_CARD"
  provider      String        // e.g. "MIDTRANS", "XENDIT"
  referenceId   String?       @unique // ID dari Payment Gateway
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  snapToken     String?
  paidAt        DateTime?
  expiredAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Voucher {
  id             String    @id @default(uuid())
  storeId        String?   // Null jika voucher platform global
  code           String    @unique
  discountAmount Decimal?  @db.Decimal(12, 2)
  discountPercent Int?     // Misal 10%
  minPurchase    Decimal?  @db.Decimal(12, 2)
  maxDiscount    Decimal?  @db.Decimal(12, 2)
  quota          Int       @default(100)
  usedCount      Int       @default(0)
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean   @default(true)

  store          Store?    @relation(fields: [storeId], references: [id])
  orders         Order[]

  @@index([storeId])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model AffiliateProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  referralCode    String   @unique
  totalCommission Decimal  @default(0.00) @db.Decimal(12, 2)

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DriverProfile {
  id           String     @id @default(uuid())
  userId       String     @unique
  vehicleType  String     // Motor, Mobil, Van
  licensePlate String
  isAvailable  Boolean    @default(true)

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  shipments    Shipment[]
}

model WarehouseStaff {
  id            String   @id @default(uuid())
  userId        String   @unique
  warehouseCode String

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ShipmentStatus {
  PENDING
  PICKUP
  IN_TRANSIT
  DELIVERED
  FAILED
}

model Shipment {
  id             String         @id @default(uuid())
  orderId        String         @unique
  driverId       String?
  courierName    String?        // e.g. "JNE", "SiCepat", "INTERNAL_DRIVER"
  courierService String?        // e.g. "REG", "BEST", "INSTANT"
  trackingNumber String         @unique
  status         ShipmentStatus @default(PENDING)
  shippedAt      DateTime?
  deliveredAt    DateTime?

  order          Order          @relation(fields: [orderId], references: [id])
  driver         DriverProfile? @relation(fields: [driverId], references: [id])

  @@index([driverId])
}

model Review {
  id        String   @id @default(uuid())
  productId String
  userId    String
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([userId])
}